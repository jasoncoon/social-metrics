{
  "include": ["src/", "scripts/"],
  "exclude": ["**/cdk.out", "**/*.js", "web-core"],
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "isolatedModules": true,
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "module": "NodeNext",
    "outDir": "dist",

    "lib": ["ES2024"]
  }
}
